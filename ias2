#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ $# == 0 || "$1" == help || "$1" == --help ]]; then
  cat <<'HELP'
I-am-S-2 — 仮説を残し、実績で確かめる
  ./ias2 run                      今日の収集・反証・検証を実行（初期設定は試行）
  ./ias2 run --run-id retry-1      失敗後に別IDで再試行
  ./ias2 status --date YYYY-MM-DD  ファイルの有無ではなく実行結果を確認
  ./ias2 validate                 設定と履歴の整合性を検査
  ./ias2 score                    短期・中期・長期の採点を表示
  ./ias2 resolve                  判定案を表示（保存はしない）
  ./ias2 apply --plan PATH        変更案を検証して追記
過去日への発行、単独モデルによる正式更新、通知、git公開は行わない。
HELP
  exit 0
fi
exec python3 "$ROOT/scripts/learning-cycle.py" "$@"
