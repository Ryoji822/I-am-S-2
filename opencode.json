{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode-go": {
      "options": {
        "baseURL": "https://opencode.ai/inference/go/openai/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    }
  },
  "model": "opencode-go/glm-5.3",
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_KEY}/v2/mcp",
      "enabled": true
    }
  }
}
