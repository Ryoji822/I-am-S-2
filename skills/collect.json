{
  "name": "collect",
  "phase": 1,
  "description": "Firecrawl MCPで最新情報を収集",
  "model": "glm-5.1",
  "prompt_file": "prompts/phase1-collect.md",
  "timeout_seconds": 600,
  "max_retries": 0,
  "inputs": [
    "config/learning_policy.json",
    "config/hypotheses.json",
    "data/forecast_ledger/transactions/"
  ],
  "outputs": [
    "state/runs/{run_id}/manifest.json"
  ],
  "validation": "strict structured records plus temporal/reference checks",
  "fallback": "preserve_saved_state",
  "entrypoint": "./ias2 run",
  "standalone_execution": false
}
